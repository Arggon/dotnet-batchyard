<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage is reported, not gated. Only production assemblies count. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Ingest.Api]*,[Ingest.Data]*,[Access.Api]*,[Access.Data]*,[Payments.Application]*,[Payments.Data]*,[Payments.Api]*,[BuildingBlocks]*,[BuildingBlocks.Messaging]*,[Legacy.Monolith]*,[Gateway]*,[BuildingBlocks.Observability]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
