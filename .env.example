# Copy to .env to change the host ports docker compose publishes (all bound to 127.0.0.1).
# Only the host side changes; containers keep talking to each other on their internal ports.
SQL_PORT=14333          # SQL Server (container 1433)
REDIS_PORT=16379        # Redis (container 6379)
RABBITMQ_PORT=15682     # RabbitMQ AMQP (container 5672)
RABBITMQ_UI_PORT=15683  # RabbitMQ management UI (container 15672), guest/guest
INGEST_PORT=8080
ACCESS_PORT=8081
PAYMENTS_PORT=8082
LEGACY_PORT=8083
GATEWAY_PORT=8000
DASHBOARD_PORT=18888    # Aspire dashboard UI
