{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "items-batch": { "ClusterId": "ingest", "Match": { "Path": "/v1/items:batch" } },
      "items": { "ClusterId": "ingest", "Match": { "Path": "/v1/items/{**rest}" } },
      "reports": { "ClusterId": "legacy", "Match": { "Path": "/v1/reports/{**rest}" } },
      "auth": { "ClusterId": "access", "Match": { "Path": "/v1/auth/{**rest}" } },
      "tenants": { "ClusterId": "access", "Match": { "Path": "/v1/tenants/{**rest}" } },
      "webhooks": { "ClusterId": "access", "Match": { "Path": "/v1/webhooks/{**rest}" } },
      "exports": { "ClusterId": "access", "Match": { "Path": "/v1/exports/{**rest}" } },
      "invoices": { "ClusterId": "payments", "Match": { "Path": "/v1/invoices/{**rest}" } },
      "payments": { "ClusterId": "payments", "Match": { "Path": "/v1/payments/{**rest}" } }
    },
    "Clusters": {
      "ingest": { "Destinations": { "d1": { "Address": "http://localhost:8080/" } } },
      "access": { "Destinations": { "d1": { "Address": "http://localhost:8081/" } } },
      "payments": { "Destinations": { "d1": { "Address": "http://localhost:8082/" } } },
      "legacy": { "Destinations": { "d1": { "Address": "http://localhost:8083/" } } }
    }
  }
}
