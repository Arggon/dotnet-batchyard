{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "batchyard-access",
    "Audience": "batchyard",
    "LifetimeMinutes": 15
  },
  "Access": {
    "RunMigrations": true,
    "TokenRequestsPerMinute": 10
  }
}
